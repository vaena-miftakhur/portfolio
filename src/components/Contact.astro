---
// Ganti YOUR_FORM_ID dengan ID Formspree kamu setelah daftar di formspree.io
const FORMSPREE_ID = 'YOUR_FORM_ID';
---

<section id="contact" class="section-padding">
  <div class="container-max">
    <div class="text-center mb-16 reveal">
      <p class="text-primary font-semibold tracking-wider uppercase text-sm mb-2">Kontak</p>
      <h2 class="text-3xl sm:text-4xl font-bold">Get In Touch</h2>
      <p class="text-gray-500 dark:text-gray-400 mt-3 max-w-lg mx-auto">
        Punya proyek atau ide menarik? Atau sekadar ingin ngobrol? Jangan ragu untuk menghubungi saya!
      </p>
    </div>

    <div class="grid lg:grid-cols-5 gap-10 max-w-4xl mx-auto">
      <!-- Contact Info -->
      <div class="lg:col-span-2 space-y-5 reveal">
        {[
          {
            icon: `<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>`,
            label: 'Email',
            value: 'vaenamiftakhurrisko@gmail.com',
            href: 'mailto:vaenamiftakhurrisko@gmail.com',
          },
          {
            icon: `<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>`,
            label: 'Lokasi',
            value: 'Tegal, Jawa Tengah',
            href: '#',
          },
        ].map((item) => (
          <a
            href={item.href}
            class="card p-4 flex items-center gap-4 hover:border-primary/30 transition-all duration-200"
          >
            <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                   class="text-primary" set:html={item.icon} />
            </div>
            <div>
              <p class="text-xs text-gray-400 dark:text-gray-500">{item.label}</p>
              <p class="text-sm font-medium text-gray-800 dark:text-gray-200">{item.value}</p>
            </div>
          </a>
        ))}
      </div>

      <!-- Form -->
      <div class="lg:col-span-3 reveal" style="animation-delay:0.2s">
        <div class="card p-6 sm:p-8">
          <div id="form-success" class="hidden text-center py-8">
            <div class="w-14 h-14 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center mx-auto mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
                   stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                   class="text-green-500">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/>
              </svg>
            </div>
            <p class="font-semibold text-gray-800 dark:text-gray-100 mb-1">Pesan Terkirim!</p>
            <p class="text-sm text-gray-500 dark:text-gray-400">Terima kasih, saya akan membalas secepatnya.</p>
          </div>

          <div id="contact-form-wrapper">
            <div class="space-y-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Nama</label>
                <input
                  id="field-name"
                  type="text"
                  placeholder="Nama lengkap kamu"
                  class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700
                         bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100
                         focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary
                         transition-all duration-200 text-sm placeholder:text-gray-400"
                />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Email</label>
                <input
                  id="field-email"
                  type="email"
                  placeholder="email@contoh.com"
                  class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700
                         bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100
                         focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary
                         transition-all duration-200 text-sm placeholder:text-gray-400"
                />
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1.5">Pesan</label>
                <textarea
                  id="field-message"
                  rows={4}
                  placeholder="Tulis pesanmu di sini..."
                  class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700
                         bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100
                         focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary
                         transition-all duration-200 text-sm placeholder:text-gray-400 resize-none"
                ></textarea>
              </div>

              <button
                id="send-btn"
                type="button"
                class="btn-primary w-full justify-center"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/>
                </svg>
                <span id="btn-text">Kirim Pesan</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ FORMSPREE_ID }}>
  const sendBtn = document.getElementById('send-btn');
  const btnText = document.getElementById('btn-text');
  const formSuccess = document.getElementById('form-success');
  const formWrapper = document.getElementById('contact-form-wrapper');

  sendBtn?.addEventListener('click', async () => {
    const name = document.getElementById('field-name').value.trim();
    const email = document.getElementById('field-email').value.trim();
    const message = document.getElementById('field-message').value.trim();

    if (!name || !email || !message) {
      alert('Mohon isi semua field ya!');
      return;
    }

    btnText.textContent = 'Mengirim...';
    sendBtn.disabled = true;

    try {
      const res = await fetch(`https://formspree.io/f/${FORMSPREE_ID}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({ name, email, message }),
      });

      if (res.ok) {
        formWrapper.classList.add('hidden');
        formSuccess.classList.remove('hidden');
      } else {
        alert('Gagal mengirim pesan. Coba lagi nanti.');
        btnText.textContent = 'Kirim Pesan';
        sendBtn.disabled = false;
      }
    } catch {
      alert('Terjadi kesalahan jaringan.');
      btnText.textContent = 'Kirim Pesan';
      sendBtn.disabled = false;
    }
  });
</script>
