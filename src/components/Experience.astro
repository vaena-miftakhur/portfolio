---
import { experiences } from '@/data/experience';
---

<section id="experience" class="section-padding">
  <div class="container-max">
    <div class="text-center mb-16 reveal">
      <p class="text-primary font-semibold tracking-wider uppercase text-sm mb-2">Perjalanan</p>
      <h2 class="text-3xl sm:text-4xl font-bold">Experience</h2>
    </div>

    <div class="max-w-2xl mx-auto">
      <div class="relative">
        <!-- Vertical line -->
        <div class="absolute left-5 top-0 bottom-0 w-0.5 bg-gradient-to-b from-primary via-primary-light to-transparent"></div>

        <div class="space-y-8">
          {experiences.map((exp, i) => (
            <div class="relative flex gap-6 reveal" style={`animation-delay:${i * 0.15}s`}>
              <!-- Dot -->
              <div class="relative z-10 flex-shrink-0">
                <div class="w-10 h-10 rounded-full bg-white dark:bg-gray-950 border-2 border-primary
                            flex items-center justify-center shadow-sm">
                  <div class="w-3 h-3 rounded-full bg-primary"></div>
                </div>
              </div>

              <!-- Content -->
              <div class="card p-5 flex-1 mb-0">
                <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
                  <h3 class="font-bold text-gray-900 dark:text-gray-100">{exp.title}</h3>
                  <span class="text-xs font-semibold text-primary bg-primary/10 px-2.5 py-1 rounded-full flex-shrink-0">
                    {exp.period}
                  </span>
                </div>
                {exp.location && (
                  <p class="text-xs text-gray-400 dark:text-gray-500 mb-2 flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
                    </svg>
                    {exp.location}
                  </p>
                )}
                <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">{exp.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
