<section id="home" class="min-h-screen flex items-center section-padding pt-24">
  <div class="container-max w-full">
    <div class="flex flex-col-reverse lg:flex-row items-center gap-12 lg:gap-20">
      <!-- Text -->
      <div class="flex-1 text-center lg:text-left">
        <p class="text-primary font-semibold tracking-wider uppercase text-sm mb-4 reveal">
          Hello, World! 
        </p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight mb-6 reveal" style="animation-delay:0.1s">
          I'm <span class="gradient-text">Vaena</span><br />
          Miftakhur Risko
        </h1>
        <div class="flex items-center gap-2 text-lg sm:text-xl text-gray-500 dark:text-gray-400 font-medium mb-8 justify-center lg:justify-start reveal" style="animation-delay:0.2s">
          <span id="typing-text" class="text-gray-700 dark:text-gray-300"></span>
          <span class="cursor"></span>
        </div>
        <p class="text-gray-500 dark:text-gray-400 max-w-lg mx-auto lg:mx-0 mb-8 leading-relaxed reveal" style="animation-delay:0.3s">
          Mahasiswa Informatika Semester 4 yang passionate di bidang web development,
          kecerdasan buatan, dan sistem pendukung keputusan.
        </p>
        <div class="flex flex-wrap gap-3 justify-center lg:justify-start mb-10 reveal" style="animation-delay:0.4s">
          <a href="/cv-vaena.pdf" download class="btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/>
            </svg>
            Download CV
          </a>
          <a href="#contact" class="btn-outline">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.15 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.06 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 8a16 16 0 0 0 5.91 5.91l.27-.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21 16z"/>
            </svg>
            Contact Me
          </a>
        </div>
        <!-- Social Links -->
        <div class="flex gap-4 justify-center lg:justify-start reveal" style="animation-delay:0.5s">
          <a href="https://github.com/vaena-miftakhur/" target="_blank" rel="noopener noreferrer"
             class="p-2.5 rounded-xl text-gray-500 dark:text-gray-400 hover:text-primary dark:hover:text-primary-light
                    hover:bg-primary/5 border border-gray-200 dark:border-gray-700 hover:border-primary/30
                    transition-all duration-200 hover:-translate-y-0.5"
             aria-label="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <a href="https://www.linkedin.com/in/vaena-risko/" target="_blank" rel="noopener noreferrer"
             class="p-2.5 rounded-xl text-gray-500 dark:text-gray-400 hover:text-primary dark:hover:text-primary-light
                    hover:bg-primary/5 border border-gray-200 dark:border-gray-700 hover:border-primary/30
                    transition-all duration-200 hover:-translate-y-0.5"
             aria-label="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href="mailto:vaenamiftakhurrisko@gmail.com"
             class="p-2.5 rounded-xl text-gray-500 dark:text-gray-400 hover:text-primary dark:hover:text-primary-light
                    hover:bg-primary/5 border border-gray-200 dark:border-gray-700 hover:border-primary/30
                    transition-all duration-200 hover:-translate-y-0.5"
             aria-label="Email">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Photo -->
      <div class="flex-shrink-0 reveal" style="animation-delay:0.2s">
        <div class="relative">
          <div class="w-56 h-56 sm:w-72 sm:h-72 lg:w-80 lg:h-80 rounded-3xl overflow-hidden
                      border-4 border-primary/20 shadow-2xl shadow-primary/10">
            <img src="/images/profile.jpeg" alt="Vaena" class="w-full h-full object-cover" />
          </div>
          <!-- Decorative blobs -->
          <div class="absolute -top-4 -right-4 w-24 h-24 bg-primary/10 rounded-full blur-2xl"></div>
          <div class="absolute -bottom-4 -left-4 w-32 h-32 bg-primary-light/10 rounded-full blur-2xl"></div>
          <!-- Floating badge -->
          <div class="absolute -bottom-3 -right-3 bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800
                      rounded-2xl px-3 py-2 shadow-lg flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span>
            <span class="text-xs font-semibold text-gray-700 dark:text-gray-300">Available for work</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const roles = ['Frontend Developer', 'Backend Developer', 'UI/UX Enthusiast', 'Problem Solver'];
  let roleIndex = 0;
  let charIndex = 0;
  let deleting = false;
  const el = document.getElementById('typing-text');

  function type() {
    if (!el) return;
    const current = roles[roleIndex];

    if (!deleting) {
      el.textContent = current.slice(0, charIndex + 1);
      charIndex++;
      if (charIndex === current.length) {
        deleting = true;
        setTimeout(type, 1800);
        return;
      }
    } else {
      el.textContent = current.slice(0, charIndex - 1);
      charIndex--;
      if (charIndex === 0) {
        deleting = false;
        roleIndex = (roleIndex + 1) % roles.length;
      }
    }
    setTimeout(type, deleting ? 60 : 100);
  }

  type();
</script>
